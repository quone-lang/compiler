cabal-version: 3.0
name:          compiler
version:       0.0.1
synopsis:      The Quone language compiler.
description:
    The Quone language compiler. Implements the initial release specified
    by docs/LANGUAGE.md: lexer, parser, AST, name resolution,
    type checking, dataframe verb typing, CSV decoding, formatting,
    LSP support, and readable R code generation.
license:       MIT
license-file:  LICENSE
build-type:    Simple

-- Files referenced by `Data.FileEmbed.embedFile` and similar TH
-- splices must be listed here so cabal includes them in the source
-- distribution and makes them available at build time.
extra-source-files:
    prelude/Prelude.Q

common shared
    default-language:   Haskell2010
    default-extensions:
        NoImplicitPrelude
        OverloadedStrings
        DeriveFunctor
        DeriveFoldable
        DeriveTraversable
        LambdaCase
        ScopedTypeVariables
        FlexibleContexts
        TupleSections
    ghc-options:        -Wall -Wno-unused-imports -Wno-unused-matches

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Quone.Position
        Quone.Diagnostic
        Quone.Diagnostic.Json
        Quone.Lex.Token
        Quone.Lex.Lexer
        Quone.Parse.Cst
        Quone.Parse.Parser
        Quone.Parse.Desugar
        Quone.Ast.Source
        Quone.Ast.Validate
        Quone.Resolve.Project
        Quone.Resolve.Names
        Quone.Type.Types
        Quone.Type.Env
        Quone.Type.Infer
        Quone.Type.Verb
        Quone.Prelude.Embed
        Quone.Prelude.Load
        Quone.Generate.Pretty
        Quone.Generate.R
        Quone.Generate.SourceMap
        Quone.Format.Doc
        Quone.Format.Trivia
        Quone.Format.Rules
        Quone.Format.Format
        Quone.Lsp.Json
        Quone.Lsp.Protocol
        Quone.Lsp.State
        Quone.Lsp.Compile
        Quone.Lsp.Symbols
        Quone.Lsp.Handlers
        Quone.Lsp.Server
        Quone.Cli.Main
        Quone.Cli.Commands
    build-depends:
        , base         ^>=4.21.0.0
        , bytestring
        , containers
        , directory
        , file-embed
        , filepath
        , megaparsec   >= 9.0 && < 10
        , nri-prelude  ^>=0.6.1.2
        , parser-combinators
        , process
        , text

executable quonec
    import:           shared
    hs-source-dirs:   app
    main-is:          quonec.hs
    build-depends:
        , base         ^>=4.21.0.0
        , compiler
        , nri-prelude  ^>=0.6.1.2

test-suite quonec-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   tests
    main-is:          Spec.hs
    other-modules:
        Test.CliTests
        Test.FormatTests
        Test.GenerateTests
        Test.Harness
        Test.LexTests
        Test.LspTests
        Test.ParseTests
        Test.ReleaseTests
        Test.TypeTests
        Test.VerbTests
    build-depends:
        , base         ^>=4.21.0.0
        , bytestring
        , compiler
        , containers   >= 0.6 && < 0.8
        , directory
        , filepath
        , nri-prelude  ^>=0.6.1.2
        , process
        , temporary
        , text
