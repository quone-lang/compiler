cabal-version: 3.0
name:          compiler
version:       0.0.0.1
build-type:    Simple

executable compiler
  main-is:            main.hs
  hs-source-dirs:     .
  default-language:   Haskell2010
  default-extensions:
    NoImplicitPrelude
    OverloadedStrings

  build-depends:
    , base         ^>=4.21.0.0
    , nri-prelude  ^>=0.6.1.2
