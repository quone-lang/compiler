{
  "name": "quone",
  "displayName": "Quone",
  "description": "Quone language support: syntax highlighting and LSP integration via quonec lsp.",
  "version": "0.0.1",
  "publisher": "quone-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/quone-lang/compiler"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "positron": "^2025.12.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:quone"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "quone",
        "aliases": ["Quone", "quone"],
        "extensions": [".Q"],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "quone.smartEnter",
        "title": "Quone: Smart Enter"
      }
    ],
    "keybindings": [
      {
        "command": "quone.smartEnter",
        "key": "enter",
        "mac": "enter",
        "when": "editorTextFocus && editorLangId == quone"
      }
    ],
    "grammars": [
      {
        "language": "quone",
        "scopeName": "source.quone",
        "path": "./syntaxes/quone.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Quone",
      "properties": {
        "quone.compilerPath": {
          "type": "string",
          "default": "quonec",
          "description": "Absolute path to the quonec executable. Falls back to whichever quonec is on PATH."
        },
        "quone.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace LSP messages between VS Code and quonec lsp."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./ --noEmit",
    "bundle": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "package": "mkdir -p dist && vsce package -o dist/quone-vscode.vsix"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.27.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
