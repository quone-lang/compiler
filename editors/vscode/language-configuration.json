{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(<-|->|of|in|exporting|then|else)\\s*$",
    "decreaseIndentPattern": "^\\s*[)\\]}].*$",
    "unIndentedLinePattern": "^\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*$",
      "action": { "indentAction": "none" }
    }
  ]
}
